<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="bus"
        Arguments=""
        InstallLocation="C:\Program Files\Kamune Org\Bus">
    </Installer>
    <PackageInformation
        PackageName="Bus"
        PackageDisplayName="Bus"
        PublisherName="CN=Kamune Org"
        PublisherDisplayName="Kamune Org"
        Version="2.3.0.0"
        PackageDescription="Kamune Chat">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="com.kamune.bus"
                Description="Kamune Chat"
                DisplayName="Bus"
                ExecutableName="bus"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>Bus</DisplayName>
            <PublisherDisplayName>Kamune Org</PublisherDisplayName>
            <Description>Kamune Chat</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="bus.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
